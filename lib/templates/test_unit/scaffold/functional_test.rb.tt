require "test_helper"

class <%= class_name %>ControllerTest < ActionDispatch::IntegrationTest
  setup do
    @<%= singular_table_name %> = <%= table_name %>(:one)
  end

  test "should get index" do
    get <%= index_helper %>_url
    assert_response :success
  end

  test "should get new" do
    get new_<%= singular_route_name %>_url
    assert_response :success
  end

  test "should create <%= singular_table_name %> via regular request" do
    assert_difference("<%= class_name %>.count") do
      post <%= index_helper %>_url, params: { <%= singular_table_name %>: { <% attributes_names.each_with_index do |attribute_name, i| %><%= attribute_name %>: @<%= singular_table_name %>.<%= attribute_name %><% if i < attributes_names.length - 1 %>, <% end %><% end %> } }
    end

    assert_redirected_to <%= singular_route_name %>_url(<%= class_name %>.last)
  end

  test "should create <%= singular_table_name %> via htmx request" do
    assert_difference("<%= class_name %>.count") do
      post <%= index_helper %>_url,
           params: { <%= singular_table_name %>: { <% attributes_names.each_with_index do |attribute_name, i| %><%= attribute_name %>: @<%= singular_table_name %>.<%= attribute_name %><% if i < attributes_names.length - 1 %>, <% end %><% end %> } },
           headers: { "HX-Request" => "true" }
    end

    assert_response :created
    assert_includes response.body, "<%= singular_table_name.humanize.downcase %>"
  end

  test "should show <%= singular_table_name %>" do
    get <%= singular_route_name %>_url(@<%= singular_table_name %>)
    assert_response :success
  end

  test "should get edit" do
    get edit_<%= singular_route_name %>_url(@<%= singular_table_name %>)
    assert_response :success
  end

  test "should update <%= singular_table_name %> via regular request" do
    patch <%= singular_route_name %>_url(@<%= singular_table_name %>), params: { <%= singular_table_name %>: { <% attributes_names.each_with_index do |attribute_name, i| %><%= attribute_name %>: @<%= singular_table_name %>.<%= attribute_name %><% if i < attributes_names.length - 1 %>, <% end %><% end %> } }

    assert_redirected_to <%= singular_route_name %>_url(@<%= singular_table_name %>)
  end

  test "should update <%= singular_table_name %> via htmx request" do
    patch <%= singular_route_name %>_url(@<%= singular_table_name %>),
          params: { <%= singular_table_name %>: { <% attributes_names.each_with_index do |attribute_name, i| %><%= attribute_name %>: @<%= singular_table_name %>.<%= attribute_name %><% if i < attributes_names.length - 1 %>, <% end %><% end %> } },
          headers: { "HX-Request" => "true" }

    assert_response :success
    assert_includes response.body, "<%= singular_table_name.humanize.downcase %>"
  end

  test "should destroy <%= singular_table_name %> via regular request" do
    assert_difference("<%= class_name %>.count", -1) do
      delete <%= singular_route_name %>_url(@<%= singular_table_name %>)
    end

    assert_redirected_to <%= index_helper %>_url
  end

  test "should destroy <%= singular_table_name %> via htmx request" do
    assert_difference("<%= class_name %>.count", -1) do
      delete <%= singular_route_name %>_url(@<%= singular_table_name %>),
             headers: { "HX-Request" => "true" }
    end

    assert_response :ok
  end
end
