<%%= form_with(model: <%= model_resource_name %>,
      local: true,
      html: {
        data: { turbo: false },
        "hx-target": "this",
        "hx-swap": "outerHTML swap:1s"
      }) do |form| %>
  <%% if <%= model_resource_name %>.errors.any? %>
    <div class="form-errors">
      <h2><%%= pluralize(<%= model_resource_name %>.errors.count, "error") %> prohibited this <%= singular_table_name %> from being saved:</h2>

      <ul>
        <%% <%= model_resource_name %>.errors.each do |error| %>
          <li><%%= error.full_message %></li>
        <%% end %>
      </ul>
    </div>
  <%% end %>

<% attributes.each do |attribute| -%>
  <div class="field">
    <%%= form.label :<%= attribute.column_name %>, style: "display: block" %>
    <% if attribute.field_type == 'text_field' -%>
    <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %>, value: "<%= <%= model_resource_name %>.<%= attribute.column_name %> %>" %>
    <% elsif attribute.field_type == 'date_field' -%>
    <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %>, value: "<%= <%= model_resource_name %>.<%= attribute.column_name %>&.to_date %>" %>
    <% else -%>
    <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %> %>
    <% end -%>
  </div>

<% end -%>
  <div class="actions">
    <%%= form.submit %>
    <%% if <%= model_resource_name %>.persisted? %>
      <button type="button"
              hx-get="<%%= <%= model_resource_name %>_path(<%= model_resource_name %>) %>"
              hx-target="closest article"
              hx-swap="outerHTML">
        Cancel
      </button>
    <%% else %>
      <button type="button"
              hx-delete="<%%= <%= index_helper %>_path %>"
              hx-target="closest div"
              hx-swap="delete">
        Cancel
      </button>
    <%% end %>
  </div>
<%% end %>
